@model IEnumerable<PCShop.Models.Wishlist>

@{
    ViewData["Title"] = "Wishlist";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-danger">
                <i class="bi bi-heart-fill"></i> Wishlist
            </h2>
            <p class="text-muted mb-0">Produsele tale favorite salvate pentru mai târziu.</p>
        </div>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Inapoi la Magazin
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-heart-break display-1 text-muted"></i>
            <h3 class="mt-3">Lista ta este goala</h3>
            <p class="text-muted">Nu ai salvat inca niciun produs.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-3">
                Exploreaza Produsele
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                if (item.Product != null)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 position-relative hover-card">

                            <a asp-action="Remove" asp-route-id="@item.WishlistId"
                               class="position-absolute top-0 end-0 m-2 btn btn-sm btn-light rounded-circle shadow-sm text-danger"
                               title="Elimina din lista">
                                <i class="bi bi-x-lg"></i>
                            </a>

                            <div class="bg-white p-3 text-center rounded-top overflow-hidden">
                                <img src="@(string.IsNullOrEmpty(item.Product.ProductImage) ? "https://via.placeholder.com/300" : item.Product.ProductImage)"
                                     class="card-img-top"
                                     alt="@item.Product.Name"
                                     style="height: 180px; object-fit: contain;">
                            </div>

                            <div class="card-body d-flex flex-column border-top">
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark border">
                                        @(item.Product.Category?.Name ?? "General")
                                    </span>
                                </div>

                                <h6 class="card-title fw-bold text-truncate">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Product.ProductId" class="text-decoration-none text-dark">
                                        @item.Product.Name
                                    </a>
                                </h6>

                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="h5 mb-0 text-primary fw-bold">@item.Product.Price RON</span>
                                    </div>

                                    <div class="d-grid gap-2">
                                        @if (item.Product.QuantityAvailable > 0)
                                        {
                                            <a asp-controller="Carts" asp-action="AddToCart" asp-route-productId="@item.Product.ProductId"
                                               class="btn btn-success btn-sm">
                                                <i class="bi bi-cart-plus"></i> Adauga în Cos
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled>Stoc Epuizat</button>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer bg-white text-muted small border-0">
                                Status:
                                @if (item.Product.QuantityAvailable > 0)
                                {
                                    <span class="text-success">In Stoc</span>
                                }
                                else
                                {
                                    <span class="text-danger">Indisponibil</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .hover-card {
        transition: transform 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>