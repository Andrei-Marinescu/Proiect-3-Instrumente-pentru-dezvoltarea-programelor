@model PCShop.Models.Cart

@{
    ViewData["Title"] = "Cosul Meu";
    decimal totalCartPrice = 0;
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-cart3"></i> Cosul de cumparaturi
        </h2>
        <span class="text-muted">
            @if (Model.CartItems != null)
            {
                <span>@Model.CartItems.Count articole</span>
            }
        </span>
    </div>

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="text-center py-5 bg-light rounded shadow-sm">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Cosul tau este gol</h3>
            <p class="text-muted">Nu ai adaugat înca niciun produs în cos.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                Incepe Cumparaturile
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4" style="width: 40%;">Produs</th>
                                        <th class="text-center">Pret</th>
                                        <th class="text-center">Cantitate</th>
                                        <th class="text-end pe-4">Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        var price = item.Product.Price;
                                        var quantity = item.Quantity ?? 1;
                                        var lineTotal = price * quantity;

                                        totalCartPrice += lineTotal;

                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 bg-white p-1 border rounded">
                                                        <img src="@(string.IsNullOrEmpty(item.Product.ProductImage) ? "https://via.placeholder.com/60" : item.Product.ProductImage)"
                                                             alt="@item.Product.Name"
                                                             style="width: 60px; height: 60px; object-fit: contain;">
                                                    </div>
                                                    <div class="ms-3">
                                                        <h6 class="mb-0 fw-bold text-dark">
                                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">
                                                                @item.Product.Name
                                                            </a>
                                                        </h6>
                                                        <small class="text-muted">Cod: @item.ProductId</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center text-muted">
                                                @price RON
                                            </td>
                                            <td class="text-center">
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline-block">
                                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                    <div class="input-group input-group-sm" style="width: 110px;">
                                                        <button type="submit" name="quantity" value="@(quantity - 1)" class="btn btn-outline-secondary">-</button>
                                                        <input type="text" class="form-control text-center bg-white" value="@quantity" readonly>
                                                        <button type="submit" name="quantity" value="@(quantity + 1)" class="btn btn-outline-secondary">+</button>
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="text-end pe-4 fw-bold text-dark">
                                                @lineTotal RON
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="RemoveFromCart" asp-route-cartItemId="@item.CartItemId" class="text-danger btn btn-link p-0" title="Sterge produs">
                                                    <i class="bi bi-trash fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Continua Cumparaturile
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm bg-white">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h5 class="mb-0 fw-bold">Sumar Comanda</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal produse:</span>
                            <span class="fw-bold">@totalCartPrice RON</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Transport estimat:</span>
                            <span class="text-success fw-bold">Gratuit</span>
                        </div>

                        <hr class="my-3">

                        <div class="d-flex justify-content-between mb-4 align-items-center">
                            <span class="h5 fw-bold mb-0">Total Final:</span>
                            <span class="h4 fw-bold text-primary mb-0">@totalCartPrice RON</span>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-success btn-lg py-3 shadow hover-elevate">
                                Finalizeaza Comanda <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <small class="text-muted"><i class="bi bi-shield-lock"></i> Plata securizata</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>