@model PCShop.Models.Order

@{
    ViewData["Title"] = "Confirmare Comandă";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="mb-3">
            <i class="bi bi-check-circle-fill text-success display-1"></i>
        </div>
        <h1 class="fw-bold text-success">Comanda ta a fost plasată cu succes!</h1>
        <p class="lead text-muted">Îți mulțumim pentru cumpărături. Mai jos ai detaliile comenzii.</p>
        <div class="mt-3">
            <span class="badge bg-light text-dark border fs-5 px-4 py-2">
                ID Comandă: <span class="fw-bold">#@Model.OrderId</span>
            </span>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informații Livrare</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted text-uppercase small fw-bold">Data Comenzii</h6>
                            <p class="fs-5 fw-bold">@Model.OrderDate.ToString("dd MMMM yyyy, HH:mm")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted text-uppercase small fw-bold">Metoda de Plată</h6>
                            <p class="fs-5">@Model.PaymentMethode</p>
                        </div>
                        <div class="col-12">
                            <h6 class="text-muted text-uppercase small fw-bold">Adresa de Livrare</h6>
                            @if (Model.Address != null)
                            {
                                <p class="fs-5 mb-0">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    @Model.Address.City, Str. @Model.Address.Street,
                                    Bl. @Model.Address.ApartmentBlock, Ap. @Model.Address.ApartmentNumber
                                </p>
                            }
                            else
                            {
                                <p class="text-danger">Adresa indisponibilă.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light py-3 border-bottom">
                    <h5 class="mb-0">Produse Comandate</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Produs</th>
                                    <th class="text-center">Preț Unitar</th>
                                    <th class="text-center">Cantitate</th>
                                    <th class="text-end pe-4">Total Linie</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null)
                                {
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        var lineTotal = (item.Price ?? 0) * (item.Quantity ?? 1);

                                        string imgSrc = "";
                                        if (item.Product != null && item.Product.ProductImage != null && item.Product.ProductImage.Length > 0)
                                        {
                                            string base64 = Convert.ToBase64String(item.Product.ProductImage);
                                            imgSrc = String.Format("data:image/jpg;base64,{0}", base64);
                                        }
                                        else
                                        {
                                            imgSrc = "https://via.placeholder.com/50?text=IMG";
                                        }

                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 bg-white border rounded p-1">
                                                        <img src="@imgSrc" alt="Produs" style="width: 50px; height: 50px; object-fit: contain;">
                                                    </div>
                                                    <div class="ms-3">
                                                        <h6 class="mb-0 fw-bold">
                                                            @if (item.Product != null)
                                                            {
                                                                @item.Product.Name
                                                            }
                                                            else
                                                            {
                                                                <span class="text-danger">Produs Șters</span>
                                                            }
                                                        </h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">@item.Price RON</td>
                                            <td class="text-center">x @item.Quantity</td>
                                            <td class="text-end pe-4 fw-bold">@lineTotal RON</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="3" class="text-end pe-4 py-3">
                                        <span class="text-muted me-2">Total Final:</span>
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <span class="h4 fw-bold text-primary mb-0">@Model.TotalAmount RON</span>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-5">
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Inapoi la Magazin
                </a>
                <a href="#" onclick="window.print()" class="btn btn-primary btn-lg">
                    <i class="bi bi-printer"></i> Printeaza Factura
                </a>
            </div>
        </div>
    </div>
</div>