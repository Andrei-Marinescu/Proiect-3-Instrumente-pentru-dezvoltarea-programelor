@model PCShop.Models.Product

@{
    ViewData["Title"] = "Editează Produs";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white p-4 rounded-top">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Editează Produsul</h3>
                    <small>Modifică detaliile componentei PC</small>
                </div>

                <div class="card-body p-5 bg-light">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="ProductId" />

                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Nume produs" />
                            <label asp-for="Name">Nume Produs</label>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" style="height: 100px" placeholder="Descriere"></textarea>
                            <label asp-for="Description">Descriere</label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Price" class="form-control" placeholder="Preț" />
                                    <label asp-for="Price">Preț (RON)</label>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="QuantityAvailable" class="form-control" placeholder="Cantitate" />
                                    <label asp-for="QuantityAvailable">Stoc Disponibil</label>
                                    <span asp-validation-for="QuantityAvailable" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-3 border-secondary shadow-sm">
                            <div class="card-body bg-white">
                                <label class="form-label fw-bold text-secondary">Imagine Produs</label>

                                <div class="mb-3 text-center">
                                    @if (Model.ProductImage != null && Model.ProductImage.Length > 0)
                                    {
                                        string base64 = Convert.ToBase64String(Model.ProductImage);
                                        string imgSrc = String.Format("data:image/jpg;base64,{0}", base64);
                                        <img src="@imgSrc" class="img-thumbnail shadow-sm" style="max-height: 150px;" alt="Imagine curenta" />
                                        <div class="small text-muted mt-1">Imagine Curentă</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">Nu există imagine setată.</div>
                                    }
                                </div>

                                <div class="input-group">
                                    <input type="file" name="imageFile" class="form-control" id="customFile" accept="image/*" />
                                    <label class="input-group-text" for="customFile">Upload Nou</label>
                                </div>
                                <small class="text-muted">Lasă gol dacă dorești să păstrezi imaginea actuală.</small>
                            </div>
                        </div>

                        <div class="card mb-4 border-secondary shadow-sm">
                            <div class="card-body bg-white">
                                <label class="form-label fw-bold text-secondary">Specificații / Manual (PDF)</label>

                                <div class="mb-3 text-center">
                                    @if (!string.IsNullOrEmpty(Model.PdfFilePath))
                                    {
                                        <div class="p-3 border rounded bg-light d-inline-block">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger" style="font-size: 2rem;"></i>
                                            <div class="fw-bold mt-1">Document curent atașat</div>
                                            <a href="@Model.PdfFilePath" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                                Vezi documentul curent
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">Nu există document PDF setat.</div>
                                    }
                                </div>

                                <div class="input-group">
                                    <input type="file" name="pdfFile" class="form-control" id="pdfUploadFile" accept=".pdf" />
                                    <label class="input-group-text" for="pdfUploadFile">Upload Nou</label>
                                </div>
                                <small class="text-muted">Lasă gol dacă dorești să păstrezi documentul actual.</small>
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ProviderId" class="form-select" asp-items="ViewBag.ProviderId">
                                        <option disabled>-- Selectează Furnizor --</option>
                                    </select>
                                    <label asp-for="ProviderId">Furnizor</label>
                                    <span asp-validation-for="ProviderId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                        <option disabled>-- Selectează Categorie --</option>
                                    </select>
                                    <label asp-for="CategoryId">Categorie</label>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2 px-4">Anulează</a>
                            <input type="submit" value="Salvează Modificările" class="btn btn-primary px-5 fw-bold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}