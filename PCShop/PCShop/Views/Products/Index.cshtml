@model IEnumerable<PCShop.Models.Product>
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Magazin Componente PC";
}

<div class="video-header-container mb-4 shadow-sm rounded overflow-hidden position-relative">
    <video autoplay loop muted playsinline class="w-100" style="max-height: 350px; object-fit: cover; filter: brightness(0.6);">
        <source src="/media/pc-video.mp4" type="video/mp4">
        Browserul tău nu suportă tag-ul video.
    </video>
    <div class="position-absolute top-50 start-50 translate-middle text-center w-100 px-3">
        <h1 class="display-4 fw-bold text-white text-shadow animation-fade-in">Descoperă Performanța Absolută</h1>
        <p class="lead text-light text-shadow animation-fade-in-delayed">Cele mai bune componente pentru sistemul tău.</p>
    </div>
</div>
<div class="bg-light p-4 rounded mb-4 shadow-sm">
    <div class="row align-items-center justify-content-between g-3">
        <div class="col-md-8 col-lg-6 mx-auto">
            <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center justify-content-center bg-white p-2 rounded border">

                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control border-start-0" placeholder="Caută componente..." />
                </div>

                <div class="input-group">
                    <span class="input-group-text bg-light text-secondary"><i class="bi bi-funnel"></i></span>
                    <select name="categoryId" class="form-select bg-light fw-bold text-dark"
                            asp-items="ViewBag.Categories" onchange="this.form.submit()">
                        <option value="">Toate Categoriile</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary px-4">Caută</button>
            </form>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-12 text-center mt-3">
                <a asp-action="Create" class="btn btn-success shadow-sm">
                    <i class="bi bi-plus-circle-fill"></i> Adauga Produs Nou
                </a>
            </div>
        }
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="text-center py-5 animation-fade-in">
            <h3 class="text-muted">Nu exista produse in aceasta categorie.</h3>
            <a asp-action="Index" class="btn btn-outline-primary mt-2">Vezi toate produsele</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @{
                int delayIndex = 0;
            }
            @foreach (var item in Model)
            {
                // Calculăm un delay dinamic pentru a crea efectul de cascadă la animație
                double delay = delayIndex * 0.15;
                delayIndex++;

                string imgSrc = "";
                if (item.ProductImage != null && item.ProductImage.Length > 0)
                {
                    string base64 = Convert.ToBase64String(item.ProductImage);
                    imgSrc = String.Format("data:image/jpg;base64,{0}", base64);
                }
                else
                {
                    imgSrc = "https://via.placeholder.com/300?text=No+Image";
                }

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card" style="animation-delay: @(delay)s;">

                        <div class="position-relative bg-white text-center overflow-hidden rounded-top">
                            <img src="@imgSrc"
                                 class="card-img-top p-4"
                                 alt="@item.Name"
                                 style="height: 250px; object-fit: contain;">

                            @if (item.QuantityAvailable > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 shadow-sm">
                                    In Stoc (@item.QuantityAvailable)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-3 shadow-sm">
                                    Stoc Epuizat
                                </span>
                            }
                        </div>

                        <div class="card-body d-flex flex-column border-top">
                            <div class="mb-2 d-flex justify-content-between align-items-center">
                                <span class="badge bg-light text-dark border">@item.Category?.Name</span>
                                <small class="text-muted">@item.Provider?.Name</small>
                            </div>

                            <h5 class="card-title text-dark fw-bold">@item.Name</h5>

                            <p class="card-text text-muted small flex-grow-1"
                               style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>

                            <div class="mt-3 d-flex align-items-center justify-content-between">
                                <h4 class="mb-0 text-primary fw-bold">@item.Price <span class="fs-6">RON</span></h4>
                            </div>
                        </div>

                        <div class="card-footer bg-white p-3 pt-0 border-0 d-flex justify-content-between align-items-center">
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-info-circle"></i> Detalii
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-warning btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-outline-danger btn-sm">Sterge</a>
                                }
                            </div>

                            @if (item.QuantityAvailable > 0)
                            {
                                <a asp-controller="Carts" asp-action="AddToCart" asp-route-productId="@item.ProductId"
                                   class="btn btn-success btn-sm shadow-sm">
                                    <i class="bi bi-cart-plus"></i> Adauga
                                </a>
                            }

                            <a asp-controller="Wishlists" asp-action="ToggleWishlist" asp-route-productId="@item.ProductId" class="btn btn-outline-danger">
                                ♥
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Efecte Hover Card */
    .product-card {
        opacity: 0; /* Invizibil la inceput pentru a permite animatiei sa ruleze */
        animation: slideUpFade 0.6s ease-out forwards;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-8px) !important;
            box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
            z-index: 2;
        }

    .card-img-top {
        transition: transform 0.4s ease;
    }

    .product-card:hover .card-img-top {
        transform: scale(1.08);
    }

    /* Animatii Text & Video */
    .text-shadow {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.7);
    }

    .animation-fade-in {
        animation: fadeIn 1.5s ease-out forwards;
    }

    .animation-fade-in-delayed {
        opacity: 0;
        animation: fadeIn 1.5s ease-out 0.8s forwards;
    }

    /* Definitii Keyframes */
    @@keyframes slideUpFade {
        0%

    {
        opacity: 0;
        transform: translateY(40px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeIn {
        0%

    {
        opacity: 0;
    }

    100% {
        opacity: 1;
    }

    }
</style>